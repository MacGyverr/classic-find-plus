<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Classic Find Plus</vendor>
  <vendor_url>https://github.com/MacGyverr/classic-find-plus</vendor_url>
  <action id="org.classicfind.plus.search">
    <description>Search protected folders with Classic Find Plus</description>
    <message>Administrator authentication is required to search protected folders</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
